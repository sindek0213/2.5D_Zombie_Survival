        type: 3}
      propertyPath: m_Text
      value: "\uC815\uBB38\uC5D0\uC11C \uC2DC\uC791\uD574 \uD589\uC815\uB3D9, 2\uCE35
        \uAD50\uC2E4\uB3D9, \uD2B9\uBCC4\uC2E4\xB7\uB3C4\uC11C\uAD00, \uAE09\uC2DD\uC2E4\uACFC
